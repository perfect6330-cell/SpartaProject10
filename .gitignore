# Unreal Engine 5 Project .gitignore

# Place this file in the same directory as DX.uproject.

# =========================================================

# Must be included in submission / repository

# =========================================================

# DX.uproject

# Config/

# Content/

# Source/

# Plugins/Temporary/Temporary.uplugin

# Plugins/Temporary/Source/

# Plugins/Temporary/Content/

# =========================================================

# Unreal Engine generated folders

# =========================================================

Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Do not ignore Build/ globally.

# In Unreal projects, Build/ may contain useful project resources such as icons.

# Build/

# =========================================================

# Plugin generated folders

# =========================================================

Plugins/**/Binaries/
Plugins/**/Intermediate/
Plugins/**/Saved/
Plugins/**/DerivedDataCache/

# =========================================================

# Visual Studio / Rider / IDE generated files

# =========================================================

.vs/
.idea/
.vscode/.browse.VC.db
.vscode/ipch/

*.sln
*.suo
*.user
*.userosscache
*.sln.docstates

*.vcxproj
*.vcxproj.filters
*.vcxproj.user

*.VC.db
*.VC.opendb
*.opensdf
*.sdf

# =========================================================

# MSVC / compiler generated files

# =========================================================

*.obj
*.pch
*.pdb
*.ilk
*.idb
*.iobj
*.ipdb
*.tlog
*.lastbuildstate
*.exp

# =========================================================

# Logs, dumps, temporary files

# =========================================================

*.log
*.tmp
*.temp
*.bak
*.swp
*.dmp
*.mdmp

# =========================================================

# OS generated files

# =========================================================

.DS_Store
Thumbs.db
desktop.ini

# =========================================================

# Optional package/build output folders

# =========================================================

Packages/
Packaged/
StagedBuilds/
Saved/StagedBuilds/
Saved/Cooked/
Saved/Crashes/
Saved/Logs/

# =========================================================

# Do not ignore Unreal assets

# =========================================================

# *.uasset

# *.umap

# *.ini
